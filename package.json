{
  "name": "order-inventory-system",
  "version": "1.0.0",
  "description": "Enterprise Full-Stack Order & Inventory Management System with MySQL ACID Transactions, Redis Caching, JWT RBAC, and React Frontend",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "simulate:flashsale": "npm run simulate:flashsale --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
